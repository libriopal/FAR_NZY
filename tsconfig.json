{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["apps/web/**/*"]
}
