# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── WebSocket (realtime multiplayer server) ──────────────────────────────────
# Default: ws://localhost:3001 (local dev)
VITE_WS_URL=ws://localhost:3001

# ─── AppLovin MAX ─────────────────────────────────────────────────────────────
VITE_APPLOVIN_SDK_KEY=your-applovin-sdk-key
VITE_APPLOVIN_REWARDED_AD_UNIT=your-rewarded-ad-unit-id
VITE_APPLOVIN_INTERSTITIAL_AD_UNIT=your-interstitial-ad-unit-id

# ─── AI Quest Generation (Anthropic) ─────────────────────────────────────────
# Set on Supabase edge function environment, NOT exposed to client
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Blockchain Relay (Polygon/Alchemy) ──────────────────────────────────────
# Set on Supabase edge function environment, NOT exposed to client
# ALCHEMY_API_KEY=...
# RELAY_WALLET_PRIVATE_KEY=...
